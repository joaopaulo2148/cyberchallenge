# ---------------------------------------------------------
# CYBER CHALLENGE - Variaveis de ambiente
# ---------------------------------------------------------
# Copie este arquivo para ".env" (ou configure as mesmas variaveis
# diretamente no seu servidor/orquestrador de containers) e preencha com
# os valores reais. Nao versione o arquivo ".env" preenchido.

# --- Servidor ---
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080
SPRING_PROFILES_ACTIVE=

# --- Banco de dados (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cyberchallenge
DB_USER=root
DB_PASSWORD=
